# mm - Claude Code 简易启动器
# Usage: mm [profile] [-- <claude args>]

set -euo pipefail

# Config paths
MM_CONFIG_DIR="${MM_CONFIG_DIR:-$HOME/.mukits}"
MM_CONFIG_FILE="$MM_CONFIG_DIR/config.json"

# Colors
