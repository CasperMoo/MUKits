DEFAULT_CONFIG="{
  \"providers\": $DEFAULT_PROVIDERS,
  \"profiles\": {},
  \"active_profile\": \"\",
  \"options\": { \"skip_permissions\": false }
}"

# ============================================
# Utility Functions
# ============================================

check_jq() {
    if ! command -v jq &>/dev/null; then
        echo -e "${RED}错误: 需要安装 jq${NC}" >&2
        echo "安装: brew install jq (macOS) 或 apt install jq (Linux)" >&2
        exit 1
    fi
}

check_curl() {
    if ! command -v curl &>/dev/null; then
        echo -e "${RED}错误: 需要安装 curl${NC}" >&2
        exit 1
    fi
}

config_get() {
    jq -r "$1 // empty" "$MM_CONFIG_FILE"
}

config_set() {
    local tmp
    tmp=$(mktemp)
    jq "$1" "$MM_CONFIG_FILE" > "$tmp" && mv "$tmp" "$MM_CONFIG_FILE"
}

init_config() {
    if [[ ! -f "$MM_CONFIG_FILE" ]]; then
        mkdir -p "$MM_CONFIG_DIR"
        echo "$DEFAULT_CONFIG" > "$MM_CONFIG_FILE"
    fi
}

get_api_key() {
    local provider="$1"
    local env_var
    env_var=$(config_get ".providers.$provider.api_key_env")
    [[ -n "${!env_var:-}" ]] && echo "${!env_var}" && return 0
    return 1
}

has_any_api_key() {
    local providers
    providers=$(config_get '.providers | keys[]')
    for p in $providers; do
        if get_api_key "$p" >/dev/null 2>&1; then
            return 0
        fi
    done
    return 1
}

has_profiles() {
    local count
    count=$(config_get '.profiles | length')
    [[ "$count" -gt 0 ]]
}

# ============================================
# Interactive Selection (Arrow Key Navigation)
# ============================================

# Enable raw mode for key detection
enable_raw_mode() {
    if [[ -t 0 ]]; then
        stty -echo -icanon time 0 min 0 2>/dev/null || true
    fi
}

# Disable raw mode
disable_raw_mode() {
    if [[ -t 0 ]]; then
        stty echo icanon 2>/dev/null || true
    fi
}

# Read a single keypress
read_key() {
    local key
    IFS= read -r -s -n1 key 2>/dev/null || return 1

    # Handle escape sequences (arrow keys)
    if [[ "$key" == $'\x1b' ]]; then
        read -r -s -n1 -t 0.1 key 2>/dev/null || return 0
        if [[ "$key" == "[" ]]; then
            read -r -s -n1 -t 0.1 key 2>/dev/null || return 0
            case "$key" in
                A) echo "UP" ;;
                B) echo "DOWN" ;;
                C) echo "RIGHT" ;;
                D) echo "LEFT" ;;
            esac
        fi
        return 0
    fi

    case "$key" in
        $'\x1b') echo "ESC" ;;
        "") echo "ENTER" ;;
        j) echo "DOWN" ;;
        k) echo "UP" ;;
        q) echo "ESC" ;;
        *) echo "$key" ;;
    esac
}

# Interactive select menu
# Usage: interactive_select <prompt> <option1> <option2> ...
# Returns selected index (0-based) or -1 if cancelled
interactive_select() {
    local prompt="$1"
    shift
    local options=("$@")
    local selected=0
    local num_options=${#options[@]}
    local key

    # Hide cursor
    tput civis 2>/dev/null || true

    # Print initial menu
    echo -e "${CYAN}$prompt${NC}"
    echo ""

    local i
    for ((i=0; i<num_options; i++)); do
        if [[ $i -eq $selected ]]; then
            echo -e "  ${GREEN}❯ ${BOLD}${options[$i]}${NC}"
        else
            echo -e "    ${options[$i]}"
        fi
    done

    # Move cursor up to start of menu
    tput cuu $((num_options + 1)) 2>/dev/null || true

    while true; do
        key=$(read_key)

        case "$key" in
            UP|k)
                if [[ $selected -gt 0 ]]; then
                    ((selected--))
                fi
                ;;
            DOWN|j)
                if [[ $selected -lt $((num_options - 1)) ]]; then
                    ((selected++))
                fi
                ;;
            ENTER)
                # Show cursor and move to end
                tput cnorm 2>/dev/null || true
                tput cud $((num_options)) 2>/dev/null || true
                echo ""
                return $selected
                ;;
            ESC|q)
                tput cnorm 2>/dev/null || true
                tput cud $((num_options)) 2>/dev/null || true
                echo ""
                return 255  # Cancelled
                ;;
            *)
                # Number key selection
                if [[ "$key" =~ ^[1-9]$ ]] && [[ $key -le $num_options ]]; then
                    selected=$((key - 1))
                    tput cnorm 2>/dev/null || true
                    tput cud $((num_options)) 2>/dev/null || true
                    echo ""
                    return $selected
                fi
                ;;
        esac

        # Redraw menu
        tput el 2>/dev/null || true
        for ((i=0; i<num_options; i++)); do
            tput cud1 2>/dev/null || echo ""
            tput el 2>/dev/null || true
            if [[ $i -eq $selected ]]; then
                echo -e "  ${GREEN}❯ ${BOLD}${options[$i]}${NC}"
            else
                echo -e "    ${options[$i]}"
            fi
        done
        tput cuu $((num_options)) 2>/dev/null || true
    done
}

# Simple yes/no prompt with arrow keys
# Usage: confirm "Prompt message" [default: y/n]
confirm() {
    local prompt="$1"
    local default="${2:-n}"
    local selected
    [[ "$default" == "y" ]] && selected=0 || selected=1

    local options=("是" "否")

    tput civis 2>/dev/null || true
    echo -e "${CYAN}$prompt${NC}"
    echo ""

    local i
    for ((i=0; i<2; i++)); do
        if [[ $i -eq $selected ]]; then
            echo -e "  ${GREEN}❯ ${options[$i]}${NC}"
        else
            echo -e "    ${options[$i]}"
        fi
    done
    tput cuu 2 2>/dev/null || true

    while true; do
        local key
        key=$(read_key)

        case "$key" in
            UP|DOWN|LEFT|RIGHT)
                selected=$((1 - selected))
                ;;
            ENTER)
                tput cnorm 2>/dev/null || true
                tput cud 2 2>/dev/null || true
                echo ""
                [[ $selected -eq 0 ]] && return 0 || return 1
                ;;
            y|Y)
                tput cnorm 2>/dev/null || true
                tput cud 2 2>/dev/null || true
                echo ""
                return 0
                ;;
            n|N|ESC|q)
                tput cnorm 2>/dev/null || true
                tput cud 2 2>/dev/null || true
                echo ""
                return 1
                ;;
        esac

        # Redraw
        tput cud1 2>/dev/null || echo ""
        tput el 2>/dev/null || true
        tput cuu 1 2>/dev/null || true

        for ((i=0; i<2; i++)); do
            tput cud1 2>/dev/null || echo ""
            tput el 2>/dev/null || true
            if [[ $i -eq $selected ]]; then
                echo -e "  ${GREEN}❯ ${options[$i]}${NC}"
            else
                echo -e "    ${options[$i]}"
            fi
        done
        tput cuu 2 2>/dev/null || true
    done
}

# ============================================
# Version & Update Functions
# ============================================

get_local_version() {
    if [[ -f "$MM_VERSION_FILE" ]]; then
        cat "$MM_VERSION_FILE"
    else
        echo "$MM_VERSION"
    fi
}

save_local_version() {
    echo "$1" > "$MM_VERSION_FILE"
}

should_check_update() {
    if [[ ! -f "$MM_LAST_CHECK_FILE" ]]; then
        return 0
    fi
    local last_check now elapsed
    last_check=$(cat "$MM_LAST_CHECK_FILE")
    now=$(date +%s)
    elapsed=$((now - last_check))
    [[ $elapsed -ge $CHECK_INTERVAL ]]
}

save_check_time() {
    date +%s > "$MM_LAST_CHECK_FILE"
}

version_lt() {
    local v1="$1" v2="$2"
    v1="${v1#v}"; v2="${v2#v}"
    local IFS=.
    read -ra v1_parts <<< "$v1"
    read -ra v2_parts <<< "$v2"
    for i in "${!v1_parts[@]}"; do
        local p1="${v1_parts[$i]:-0}" p2="${v2_parts[$i]:-0}"
        p1="${p1%%[!0-9]*}"; p2="${p2%%[!0-9]*}"
        [[ "$p1" -lt "$p2" ]] && return 0
        [[ "$p1" -gt "$p2" ]] && return 1
    done
    return 1
}

fetch_remote_version() {
    local response
    response=$(curl -sL --connect-timeout 5 --max-time 10 "$MM_VERSION_URL" 2>/dev/null) || return 1
    echo "$response" | jq -r '.version // empty' 2>/dev/null
}

fetch_changelog() {
    local response
    response=$(curl -sL --connect-timeout 5 --max-time 10 "$MM_VERSION_URL" 2>/dev/null) || return 1
    echo "$response" | jq -r '.changelog[]? // empty' 2>/dev/null
}

check_for_update() {
    local check_only="${1:-false}"
    if ! should_check_update && [[ "$check_only" != "true" ]]; then
        return 1
    fi
    check_curl
    local remote_version
    remote_version=$(fetch_remote_version)
    [[ -z "$remote_version" ]] && return 1
    save_check_time
    local local_version
    local_version=$(get_local_version)
    if version_lt "$local_version" "$remote_version"; then
        echo "$remote_version"
        return 0
    fi
    return 1
}

show_update_prompt() {
    local new_version="$1"
    local local_version
    local_version=$(get_local_version)

    echo ""
    echo -e "${CYAN}╭─────────────────────────────────────────╮${NC}"
    echo -e "${CYAN}│  发现新版本: v$new_version (当前 v$local_version)    │${NC}"
    echo -e "${CYAN}╰─────────────────────────────────────────╯${NC}"
    echo ""

    local changelog
    changelog=$(fetch_changelog)
    if [[ -n "$changelog" ]]; then
        echo "  更新内容:"
        while IFS= read -r line; do
            echo -e "  ${GREEN}•${NC} $line"
        done <<< "$changelog"
        echo ""
    fi

    if confirm "是否更新？"; then
        do_update
    else
        echo -e "${YELLOW}已跳过更新${NC}"
    fi
}

do_update() {
    echo ""
    echo -e "${BLUE}正在更新...${NC}"
    local tmp_script
    tmp_script=$(mktemp)
    if curl -sL --connect-timeout 10 --max-time 30 "$MM_INSTALL_URL" -o "$tmp_script" 2>/dev/null; then
        if bash "$tmp_script" --update; then
            rm -f "$tmp_script"
            echo ""
            echo -e "${GREEN}✓ 更新完成！${NC}"
            echo ""
            echo "  重新运行 ${CYAN}mm${NC} 以使用新版本"
            exit 0
        else
            rm -f "$tmp_script"
            echo -e "${RED}✗ 更新失败${NC}"
            echo "  请手动运行: curl -sL $MM_INSTALL_URL | bash"
            return 1
        fi
    else
        rm -f "$tmp_script"
        echo -e "${RED}✗ 无法下载更新脚本${NC}"
        return 1
    fi
}

# ============================================
# Setup Wizard
# ============================================

show_banner() {
    echo ""
    echo -e "${CYAN}╔════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║           MM 配置向导                   ║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════════╝${NC}"
    echo ""
}

setup_main_menu() {
    local options=("新建配置      - 选择服务商、设置 Key、选择模板"
                   "管理 API Key  - 查看/设置/申请 Key"
                   "切换配置      - 在已有配置间切换"
                   "启动选项      - 跳过权限确认等全局设置"
                   "查看当前状态  - 显示当前配置"
                   "退出")

    while true; do
        show_banner

        interactive_select "请选择操作:" "${options[@]}"
        local choice=$?

        case $choice in
            0) setup_new_profile ;;
            1) setup_manage_keys ;;
            2) setup_switch_profile ;;
            3) setup_options ;;
            4) show_status ;;
            5|255) echo "再见！"; exit 0 ;;
        esac
        echo ""
        echo -e "${BLUE}按回车继续...${NC}"
        read -r
    done
}

setup_new_profile() {
    echo ""
    echo -e "${BLUE}步骤 1: 选择服务商${NC}"
    echo ""

    local provider_names=("智谱 GLM" "DeepSeek" "火山引擎" "阿里云百炼" "硅基流动" "Anthropic" "OpenRouter")
    local provider_descs=("国产领先，性价比高" "能力强，价格低" "字节豆包，稳定可靠" "通义千问，生态完整" "聚合平台，模型丰富" "Claude 官方 API" "全球模型聚合平台")
    local provider_ids=("glm" "deepseek" "volcengine" "aliyun" "siliconflow" "anthropic" "openrouter")

    # Build options with descriptions
    local options=()
    local i
    for i in "${!provider_names[@]}"; do
        options+=("${provider_names[$i]} - ${provider_descs[$i]}")
    done

    echo -e "  ${YELLOW}国内服务商（推荐）:${NC}"
    interactive_select "" "${options[@]:0:5}"
    local provider_idx=$?

    if [[ $provider_idx -eq 255 ]]; then
        echo -e "${YELLOW}已取消${NC}"
        return
    fi

    if [[ $provider_idx -ge 5 ]]; then
        echo -e "  ${YELLOW}国外服务商:${NC}"
        interactive_select "" "${options[@]:5:2}"
        local sub_idx=$?
        if [[ $sub_idx -eq 255 ]]; then
            echo -e "${YELLOW}已取消${NC}"
            return
        fi
        provider_idx=$((5 + sub_idx))
    fi

    local provider="${provider_ids[$provider_idx]}"
    local provider_name
    provider_name=$(config_get ".providers.$provider.name")

    # Check API Key
    echo ""
    echo -e "${BLUE}步骤 2: 设置 API Key${NC}"
    echo ""

    if get_api_key "$provider" >/dev/null 2>&1; then
        echo -e "${GREEN}✓ $provider_name API Key 已配置${NC}"
    else
        local apply_url
        apply_url=$(config_get ".providers.$provider.apply_url")

        echo -e "${YELLOW}$provider_name API Key: 未配置${NC}"
        echo ""
        echo "  申请地址: $apply_url"
        echo ""

        local key_options=("打开网页申请" "我已有 Key" "跳过")
        interactive_select "请选择:" "${key_options[@]}"
        local key_choice=$?

        case $key_choice in
            0)
                if command -v open &>/dev/null; then
                    open "$apply_url"
                elif command -v xdg-open &>/dev/null; then
                    xdg-open "$apply_url"
                fi
                echo ""
                echo -e "${BLUE}获取到 Key 后按回车继续...${NC}"
                read -r
                setup_new_profile
                return
                ;;
            1)
                local env_var
                env_var=$(config_get ".providers.$provider.api_key_env")
                echo ""
                read -p "请输入 API Key: " -r api_key
                if [[ -n "$api_key" ]]; then
                    export "$env_var"="$api_key"
                    echo ""
                    if confirm "是否永久保存到 ~/.zshrc？"; then
                        echo "export $env_var='$api_key'" >> ~/.zshrc
                        echo -e "${GREEN}✓ 已添加到 ~/.zshrc${NC}"
                    fi
                fi
                ;;
            2|255)
                echo -e "${YELLOW}已跳过，可稍后运行 'mm setup' 配置${NC}"
                return
                ;;
        esac
    fi

    # Select preset
    echo ""
    echo -e "${BLUE}步骤 3: 选择性能模式${NC}"
    echo ""

    local preset_options=("快速 (Fast)      - 响应快，价格低，适合日常对话"
                          "均衡 (Balanced)  - 性价比最优，推荐大多数场景"
                          "强大 (Powerful)  - 最强能力，适合复杂任务")
    local preset_names=("fast" "balanced" "powerful")

    interactive_select "请选择:" "${preset_options[@]}"
    local preset_idx=$?

    if [[ $preset_idx -eq 255 ]]; then
        echo -e "${YELLOW}已取消${NC}"
        return
    fi

    local preset_name="${preset_names[$preset_idx]}"

    # Create profile
    local profile_name="${provider}-${preset_name}"
    local haiku sonnet opus
    haiku=$(config_get ".providers.$provider.presets.$preset_name.haiku")
    sonnet=$(config_get ".providers.$provider.presets.$preset_name.sonnet")
    opus=$(config_get ".providers.$provider.presets.$preset_name.opus")

    config_set ".profiles.$profile_name = {
        \"provider\": \"$provider\",
        \"preset\": \"$preset_name\",
        \"haiku\": \"$haiku\",
        \"sonnet\": \"$sonnet\",
        \"opus\": \"$opus\"
    }"
    config_set ".active_profile = \"$profile_name\""

    echo ""
    echo -e "${GREEN}✓ 配置完成！${NC}"
    echo ""
    echo "  当前配置: $provider_name ($preset_name)"
    echo ""
    echo "  运行 ${CYAN}mm${NC} 开始使用"
}

setup_manage_keys() {
    echo ""
    echo -e "${BLUE}API Key 配置状态${NC}"
    echo ""

    local provider_ids=("glm" "deepseek" "volcengine" "aliyun" "siliconflow" "anthropic" "openrouter")

    for p in "${provider_ids[@]}"; do
        local name env_var
        name=$(config_get ".providers.$p.name")
        env_var=$(config_get ".providers.$p.api_key_env")
        if [[ -n "${!env_var:-}" ]]; then
            echo -e "  ${GREEN}✓${NC} $name ${GREEN}已配置${NC}"
        else
            echo -e "  ${RED}✗${NC} $name ${RED}未配置${NC}"
        fi
    done

    echo ""
    local actions=("设置 Key" "打开申请页面" "返回")
    interactive_select "请选择:" "${actions[@]}"
    local action=$?

    case $action in
        0)
            echo ""
            local provider_names=()
            for p in "${provider_ids[@]}"; do
                provider_names+=("$(config_get ".providers.$p.name")")
            done
            interactive_select "选择要设置的服务商:" "${provider_names[@]}"
            local idx=$?
            if [[ $idx -eq 255 ]]; then return; fi
            local provider="${provider_ids[$idx]}"
            local env_var
            env_var=$(config_get ".providers.$provider.api_key_env")
            echo ""
            read -p "请输入 API Key: " -r api_key
            if [[ -n "$api_key" ]]; then
                export "$env_var"="$api_key"
                if confirm "是否永久保存到 ~/.zshrc？"; then
                    echo "export $env_var='$api_key'" >> ~/.zshrc
                    echo -e "${GREEN}✓ 已添加到 ~/.zshrc${NC}"
                fi
            fi
            ;;
        1)
            echo ""
            local provider_names=()
            for p in "${provider_ids[@]}"; do
                provider_names+=("$(config_get ".providers.$p.name")")
            done
            interactive_select "选择要打开的服务商:" "${provider_names[@]}"
            local idx=$?
            if [[ $idx -eq 255 ]]; then return; fi
            local provider="${provider_ids[$idx]}"
            local apply_url
            apply_url=$(config_get ".providers.$provider.apply_url")
            if command -v open &>/dev/null; then
                open "$apply_url"
            elif command -v xdg-open &>/dev/null; then
                xdg-open "$apply_url"
            fi
            ;;
        2|255)
            return
            ;;
    esac
}

setup_switch_profile() {
    echo ""
    echo -e "${BLUE}切换配置${NC}"
    echo ""

    local profiles
    profiles=($(config_get '.profiles | keys[]'))

    if [[ ${#profiles[@]} -eq 0 ]]; then
        echo -e "${YELLOW}暂无配置，请先新建配置${NC}"
        return
    fi

    local active
    active=$(config_get '.active_profile')

    interactive_select "选择配置:" "${profiles[@]}"
    local idx=$?

    if [[ $idx -eq 255 ]]; then
        echo -e "${YELLOW}已取消${NC}"
        return
    fi

    local profile="${profiles[$idx]}"
    config_set ".active_profile = \"$profile\""
    echo -e "${GREEN}✓ 已切换到: $profile${NC}"
}

setup_options() {
    echo ""
    echo -e "${BLUE}启动选项${NC}"
    echo ""

    local skip
    skip=$(config_get '.options.skip_permissions')

    echo "  跳过权限确认"
    echo ""
    echo "  启用后，Claude Code 将自动执行命令，无需每次确认"
    echo "  适合信任 Claude 的进阶用户"
    echo ""

    if [[ "$skip" == "true" ]]; then
        echo -e "  当前状态: ${GREEN}已启用${NC}"
    else
        echo -e "  当前状态: ${YELLOW}未启用${NC}"
    fi
    echo ""

    if confirm "是否启用？"; then
        config_set '.options.skip_permissions = true'
        echo -e "${GREEN}✓ 已启用${NC}"
    else
        config_set '.options.skip_permissions = false'
        echo -e "${GREEN}✓ 已禁用${NC}"
    fi
}

show_status() {
    echo ""
    echo -e "${BLUE}当前配置状态${NC}"
    echo ""

    local active
    active=$(config_get '.active_profile')

    if [[ -z "$active" ]]; then
        echo -e "  ${YELLOW}暂无活跃配置${NC}"
        echo ""
        echo "  运行 ${CYAN}mm setup${NC} 创建配置"
        return
    fi

    local provider preset haiku sonnet opus provider_name
    provider=$(config_get ".profiles.$active.provider")
    preset=$(config_get ".profiles.$active.preset")
    haiku=$(config_get ".profiles.$active.haiku")
    sonnet=$(config_get ".profiles.$active.sonnet")
    opus=$(config_get ".profiles.$active.opus")
    provider_name=$(config_get ".providers.$provider.name")

    echo "  活跃配置: $active"
    echo "  服务商:   $provider_name"
    echo "  性能模式: $preset"
    echo ""
    echo "  模型配置:"
    echo "    haiku:  $haiku"
    echo "    sonnet: $sonnet"
    echo "    opus:   $opus"
    echo ""

    local skip
    skip=$(config_get '.options.skip_permissions')
    if [[ "$skip" == "true" ]]; then
        echo -e "  启动选项: ${GREEN}跳过权限确认${NC}"
    fi

    local version
    version=$(get_local_version)
    echo "  版本:     v$version"
}

# ============================================
# Launch Functions
# ============================================

select_and_launch() {
    local profiles
    profiles=($(config_get '.profiles | keys[]'))

    if [[ ${#profiles[@]} -eq 0 ]]; then
        echo -e "${YELLOW}暂无配置，请先运行 'mm setup' 创建配置${NC}"
        return
    fi

    local active
    active=$(config_get '.active_profile')

    if [[ ${#profiles[@]} -eq 1 ]]; then
        launch_profile "${profiles[0]}"
        return
    fi

    echo ""
    interactive_select "选择配置:" "${profiles[@]}"
    local idx=$?

    if [[ $idx -eq 255 ]]; then
        echo -e "${YELLOW}已取消${NC}"
        return
    fi

    local profile="${profiles[$idx]}"
    launch_profile "$profile" "$@"
}

launch_profile() {
    local profile="$1"
    shift 2>/dev/null || true

    local provider haiku sonnet opus base_url api_key provider_name
    provider=$(config_get ".profiles.$profile.provider")
    haiku=$(config_get ".profiles.$profile.haiku")
    sonnet=$(config_get ".profiles.$profile.sonnet")
    opus=$(config_get ".profiles.$profile.opus")
    base_url=$(config_get ".providers.$provider.base_url")
    provider_name=$(config_get ".providers.$provider.name")

    api_key=$(get_api_key "$provider")
    if [[ -z "$api_key" ]]; then
        echo -e "${RED}错误: $provider_name API Key 未配置${NC}"
        echo ""
        echo "运行 ${CYAN}mm setup${NC} 进行配置"
        exit 1
    fi

    config_set ".active_profile = \"$profile\""

    echo -e "${GREEN}✓ 已切换到: $provider_name${NC}"
    echo ""

    export ANTHROPIC_BASE_URL="$base_url"
    export ANTHROPIC_AUTH_TOKEN="$api_key"
    export ANTHROPIC_DEFAULT_HAIKU_MODEL="$haiku"
    export ANTHROPIC_DEFAULT_SONNET_MODEL="$sonnet"
    export ANTHROPIC_DEFAULT_OPUS_MODEL="$opus"

    local claude_args=()
    local skip
    skip=$(config_get '.options.skip_permissions')
    if [[ "$skip" == "true" ]]; then
        claude_args+=("--dangerously-skip-permissions")
    fi
    claude_args+=("$@")

    exec claude "${claude_args[@]}"
}

# ============================================
# Main
# ============================================

show_help() {
    local version
    version=$(get_local_version)
    cat << HELP
MM - Claude Code 简易启动器 v$version

用法:
  mm              交互式选择配置并启动
  mm <profile>    直接使用指定配置启动
  mm setup        配置向导
  mm update       检查并更新
  mm uninstall    卸载 MUKits
  mm version      显示版本信息
  mm help         显示帮助

配置文件: ~/.mukits/config.json
项目地址: https://github.com/CasperMoo/MUKits
HELP
}

main() {
    trap 'disable_raw_mode' EXIT
    check_jq
    init_config

    local command="${1:-}"

    case "$command" in
        "")
            if ! has_profiles || ! has_any_api_key; then
                echo -e "${YELLOW}首次使用，请先配置${NC}"
                setup_main_menu
                return
            fi

            local new_version
            new_version=$(check_for_update)
            if [[ -n "$new_version" ]]; then
                show_update_prompt "$new_version"
            else
                local version
                version=$(get_local_version)
                echo -e "${GREEN}✓ 已是最新版本 v$version${NC}"
            fi

            select_and_launch "$@"
            ;;

        setup)
            setup_main_menu
            ;;

        update)
            echo "检查更新..."
            local new_version
            new_version=$(check_for_update "true")
            if [[ -n "$new_version" ]]; then
                show_update_prompt "$new_version"
            else
                local version
                version=$(get_local_version)
                echo -e "${GREEN}✓ 已是最新版本 v$version${NC}"
            fi
            ;;

        uninstall)
            local uninstall_url="https://raw.githubusercontent.com/CasperMoo/MUKits/main/uninstall.sh"
            echo "正在启动卸载程序..."
            if command -v curl &>/dev/null; then
                curl -sL "$uninstall_url" | bash
            else
                echo -e "${RED}需要 curl 来运行卸载程序${NC}"
                echo "请手动访问: $uninstall_url"
            fi
            ;;

        version|--version|-v)
            local version
            version=$(get_local_version)
            echo "MM v$version"
            ;;

        help|-h|--help)
            show_help
            ;;

        *)
            if config_get ".profiles.$command" >/dev/null 2>&1; then
                launch_profile "$@"
            else
                echo -e "${RED}错误: 未知命令或配置 '$command'${NC}"
                echo ""
                echo "运行 ${CYAN}mm help${NC} 查看帮助"
                exit 1
            fi
            ;;
    esac
}

main "$@"
