#!/usr/bin/env bash
# mm - Claude Code 简易启动器

set -euo pipefail

# Config paths
MM_CONFIG_DIR="${MM_CONFIG_DIR:-$HOME/.mukits}"
MM_CONFIG_FILE="$MM_CONFIG_DIR/config.json"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Default providers
DEFAULT_PROVIDERS='{
  "glm":        {"name": "智谱 GLM",    "base_url": "https://open.bigmodel.cn/api/anthropic",          "api_key_env": "GLM_API_KEY",        "apply_url": "https://open.bigmodel.cn/",
    "models": ["glm-4.7", "glm-5"]},
  "deepseek":   {"name": "DeepSeek",    "base_url": "https://api.deepseek.com/anthropic",               "api_key_env": "DEEPSEEK_API_KEY",   "apply_url": "https://platform.deepseek.com/",
    "models": ["deepseek-chat", "deepseek-v3"]},
  "volcengine": {"name": "火山引擎",    "base_url": "https://ark.cn-beijing.volces.com/api/v3/",         "api_key_env": "VOLCENGINE_API_KEY", "apply_url": "https://console.volcengine.com/ark",
    "models": ["doubao-pro-32k", "doubao-pro-256k"]},
  "aliyun":     {"name": "阿里云百炼",  "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1","api_key_env": "ALIYUN_API_KEY",     "apply_url": "https://bailian.console.aliyun.com/",
    "models": ["qwen-turbo", "qwen-plus", "qwen-max"]},
  "siliconflow":{"name": "硅基流动",    "base_url": "https://api.siliconflow.cn/v1",                    "api_key_env": "SILICONFLOW_API_KEY","apply_url": "https://cloud.siliconflow.cn/",
    "models": ["Qwen/Qwen2.5-7B-Instruct", "Qwen/Qwen2.5-72B-Instruct", "deepseek-ai/DeepSeek-V3"]},
  "anthropic":  {"name": "Anthropic",   "base_url": "https://api.anthropic.com",                        "api_key_env": "ANTHROPIC_API_KEY",  "apply_url": "https://console.anthropic.com/",
    "models": ["claude-haiku-4-20250514", "claude-sonnet-4-20250514", "claude-opus-4-20250514"]},
  "openrouter": {"name": "OpenRouter",  "base_url": "https://openrouter.ai/api/v1",                     "api_key_env": "OPENROUTER_API_KEY", "apply_url": "https://openrouter.ai/",
    "models": ["anthropic/claude-haiku-4", "anthropic/claude-sonnet-4", "anthropic/claude-opus-4"]}
}'

DEFAULT_CONFIG="{\"providers\": $DEFAULT_PROVIDERS, \"profiles\": {}, \"active_profile\": \"\", \"options\": {\"skip_permissions\": false}}"

# Utility
check_jq() {
    if ! command -v jq &>/dev/null; then
        echo -e "${RED}错误: 需要安装 jq${NC}" >&2
        exit 1
    fi
}

config_get() { jq -r "$1 // empty" "$MM_CONFIG_FILE"; }
config_set() { local tmp; tmp=$(mktemp); jq "$1" "$MM_CONFIG_FILE" > "$tmp" && mv "$tmp" "$MM_CONFIG_FILE"; }

init_config() {
    if [[ ! -f "$MM_CONFIG_FILE" ]]; then
        mkdir -p "$MM_CONFIG_DIR"
        echo "$DEFAULT_CONFIG" > "$MM_CONFIG_FILE"
    fi
}

get_api_key() {
    local provider="$1"
    # First check config.json
    local stored_key
    stored_key=$(config_get ".providers.$provider.api_key")
    [[ -n "$stored_key" ]] && echo "$stored_key" && return 0
    # Fall back to env var
    local env_var
    env_var=$(config_get ".providers.$provider.api_key_env")
    [[ -n "${!env_var:-}" ]] && echo "${!env_var}" && return 0
    return 1
}

has_any_api_key() {
    local providers
    providers=$(config_get '.providers | keys[]')
    for p in $providers; do
        get_api_key "$p" >/dev/null 2>&1 && return 0
    done
    return 1
}

has_profiles() {
    [[ $(config_get '.profiles | length') -gt 0 ]]
}

# fzf selection
fzf_select() {
    local prompt="$1"; shift
    local items=("$@")

    if command -v fzf &>/dev/null; then
        printf '%s\n' "${items[@]}" | fzf \
            --height=20 \
            --layout=reverse \
            --prompt="$prompt " \
            --cycle \
            --no-info \
            --ansi \
            --color='pointer:2,marker:2' \
            --bind 'j:down,k:up' \
            --header="↑↓/jk 选择 | 回车确认 | ESC 取消" \
            2>/dev/null || true
    else
        echo -e "${CYAN}$prompt${NC}"
        local i
        for ((i=0; i<${#items[@]}; i++)); do
            echo "  $((i+1))) ${items[$i]}"
        done
        echo ""
        while true; do
            read -p "请选择 [1-${#items[@]}]: " -r choice
            [[ "$choice" =~ ^[1-9][0-9]*$ ]] && [[ "$choice" -le ${#items[@]} ]] && { echo "${items[$((choice-1))]}"; return; }
            [[ "$choice" =~ ^[qQxX]$ ]] && { echo ""; return; }
        done
    fi
}

# Setup wizard
setup_wizard() {
    echo ""
    echo -e "${CYAN}╔════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║           MM 配置向导                   ║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════════╝${NC}"

    while true; do
        echo ""
        local action
        action=$(fzf_select "请选择操作:" \
            "新建配置 - 选择服务商并设置 Key" \
            "管理 API Key - 查看/设置/申请 Key" \
            "切换配置 - 在已有配置间切换" \
            "启动选项 - 跳过权限确认等设置" \
            "查看状态 - 显示当前配置" \
            "编辑配置文件 - 手动编辑高级选项" \
            "退出")

        [[ -z "$action" ]] && { echo "再见！"; exit 0; }

        case "$action" in
            新建配置*) setup_new_profile ;;
            管理*Key*) setup_manage_keys ;;
            切换配置*) setup_switch_profile ;;
            启动选项*) setup_options ;;
            查看状态*) show_status ;;
            编辑配置文件*)
                if command -v "${EDITOR:-}" &>/dev/null 2>&1; then
                    "${EDITOR}" "$MM_CONFIG_FILE"
                elif command -v open &>/dev/null; then
                    open "$MM_CONFIG_FILE"
                else
                    echo -e "${YELLOW}请手动编辑: $MM_CONFIG_FILE${NC}"
                fi
                ;;
            退出) echo "再见！"; exit 0 ;;
        esac

        echo ""
        echo -e "${BLUE}按回车继续...${NC}"
        read -r
    done
}

setup_new_profile() {
    echo ""
    echo -e "${BLUE}步骤 1: 选择服务商${NC}"

    local provider
    provider=$(fzf_select "选择服务商:" \
        "智谱 GLM - 国产领先，性价比高" \
        "DeepSeek - 能力强，价格低" \
        "火山引擎 - 字节豆包，稳定可靠" \
        "阿里云百炼 - 通义千问，生态完整" \
        "硅基流动 - 聚合平台，模型丰富" \
        "Anthropic - Claude 官方 API" \
        "OpenRouter - 全球模型聚合平台")

    [[ -z "$provider" ]] && { echo -e "${YELLOW}已取消${NC}"; return; }

    local provider_id
    case "$provider" in
        智谱*) provider_id="glm" ;;
        DeepSeek*) provider_id="deepseek" ;;
        火山*) provider_id="volcengine" ;;
        阿里*) provider_id="aliyun" ;;
        硅基*) provider_id="siliconflow" ;;
        Anthropic*) provider_id="anthropic" ;;
        OpenRouter*) provider_id="openrouter" ;;
        *) return ;;
    esac

    local provider_name
    provider_name=$(config_get ".providers.$provider_id.name")

    echo ""
    echo -e "${BLUE}步骤 2: 设置 API Key${NC}"

    local existing_key
    existing_key=$(get_api_key "$provider_id" 2>/dev/null || true)
    if [[ -n "$existing_key" ]]; then
        local masked="${existing_key:0:4}****${existing_key: -4}"
        local key_action
        key_action=$(fzf_select "API Key 已配置 ($masked):" "使用现有 Key" "修改 Key")
        [[ -z "$key_action" ]] && { echo -e "${YELLOW}已取消${NC}"; return; }
        if [[ "$key_action" == 修改* ]]; then
            read -p "请输入新 API Key: " -r api_key
            if [[ -n "$api_key" ]]; then
                config_set ".providers.$provider_id.api_key = \"$api_key\""
                echo -e "${GREEN}✓ 已更新到 $MM_CONFIG_FILE${NC}"
            else
                echo -e "${YELLOW}未输入 Key，保留现有配置${NC}"
            fi
        fi
    else
        local apply_url
        apply_url=$(config_get ".providers.$provider_id.apply_url")
        echo -e "${YELLOW}$provider_name API Key: 未配置${NC}"
        echo "  申请地址: $apply_url"

        local key_action
        key_action=$(fzf_select "请选择:" "打开网页申请" "我已有 Key" "跳过")

        [[ -z "$key_action" ]] && { echo -e "${YELLOW}已取消${NC}"; return; }

        case "$key_action" in
            打开*)
                command -v open &>/dev/null && open "$apply_url" || command -v xdg-open &>/dev/null && xdg-open "$apply_url"
                echo -e "${BLUE}获取到 Key 后重新运行 mm setup${NC}"
                return
                ;;
            我已有*)
                read -p "请输入 API Key: " -r api_key
                if [[ -n "$api_key" ]]; then
                    config_set ".providers.$provider_id.api_key = \"$api_key\""
                    echo -e "${GREEN}✓ 已保存到 $MM_CONFIG_FILE${NC}"
                else
                    echo -e "${YELLOW}未输入 Key，已取消${NC}"
                    return
                fi
                ;;
            跳过*)
                echo -e "${YELLOW}已跳过${NC}"
                return
                ;;
        esac
    fi

    # 默认：第一个模型 → haiku（轻量），最后一个 → sonnet/opus（最强）
    local haiku sonnet opus
    haiku=$(config_get ".providers.$provider_id.models[0]")
    local last_idx
    last_idx=$(config_get ".providers.$provider_id.models | length - 1")
    sonnet=$(config_get ".providers.$provider_id.models[$last_idx]")
    opus="$sonnet"

    config_set ".profiles[\"$provider_id\"] = {\"provider\": \"$provider_id\", \"haiku\": \"$haiku\", \"sonnet\": \"$sonnet\", \"opus\": \"$opus\"}"
    config_set ".active_profile = \"$provider_id\""

    echo ""
    echo -e "${GREEN}✓ 配置完成！${NC}"
    echo "  服务商: $provider_name"
    echo "  模型:   haiku=$haiku / sonnet=$sonnet / opus=$opus"
    echo ""
    echo "  运行 ${CYAN}mm${NC} 开始使用"
}

setup_manage_keys() {
    echo ""
    echo -e "${BLUE}API Key 管理${NC}"

    local provider_ids=("glm" "deepseek" "volcengine" "aliyun" "siliconflow" "anthropic" "openrouter")
    local items=()
    for p in "${provider_ids[@]}"; do
        local name status
        name=$(config_get ".providers.$p.name")
        if get_api_key "$p" >/dev/null 2>&1; then
            status="${GREEN}✓ 已配置${NC}"
        else
            status="${RED}✗ 未配置${NC}"
        fi
        items+=("$(echo -e "$name  $status")")
    done

    local choice
    choice=$(fzf_select "选择要设置的服务商:" "${items[@]}")
    [[ -z "$choice" ]] && return

    # Map display name back to provider_id
    local provider_id=""
    for p in "${provider_ids[@]}"; do
        local name
        name=$(config_get ".providers.$p.name")
        if [[ "$choice" == *"$name"* ]]; then
            provider_id="$p"
            break
        fi
    done
    [[ -z "$provider_id" ]] && return

    local provider_name apply_url
    provider_name=$(config_get ".providers.$provider_id.name")
    apply_url=$(config_get ".providers.$provider_id.apply_url")

    echo ""
    if get_api_key "$provider_id" >/dev/null 2>&1; then
        echo -e "  ${GREEN}✓ $provider_name 当前已配置${NC}"
    else
        echo -e "  ${RED}✗ $provider_name 尚未配置${NC}"
        echo "  申请地址: $apply_url"
    fi

    echo ""
    read -p "请输入新的 API Key（留空取消）: " -r api_key
    if [[ -n "$api_key" ]]; then
        config_set ".providers.$provider_id.api_key = \"$api_key\""
        echo -e "${GREEN}✓ 已保存到 $MM_CONFIG_FILE${NC}"
    else
        echo -e "${YELLOW}已取消${NC}"
    fi
}

setup_switch_profile() {
    echo ""
    local profiles
    profiles=($(config_get '.profiles | keys[]'))

    [[ ${#profiles[@]} -eq 0 ]] && { echo -e "${YELLOW}暂无配置${NC}"; return; }

    local profile
    profile=$(fzf_select "选择配置:" "${profiles[@]}")

    [[ -n "$profile" ]] && { config_set ".active_profile = \"$profile\""; echo -e "${GREEN}✓ 已切换到: $profile${NC}"; }
}

setup_options() {
    echo ""
    echo -e "${BLUE}启动选项${NC}"
    local skip
    skip=$(config_get '.options.skip_permissions')
    echo -e "  跳过权限确认: $([[ "$skip" == "true" ]] && echo -e "${GREEN}已启用${NC}" || echo -e "${YELLOW}未启用${NC}")"

    local choice
    choice=$(fzf_select "跳过权限确认:" "启用" "禁用")

    [[ -z "$choice" ]] && return

    case "$choice" in
        启用) config_set '.options.skip_permissions = true'; echo -e "${GREEN}✓ 已启用${NC}" ;;
        禁用) config_set '.options.skip_permissions = false'; echo -e "${GREEN}✓ 已禁用${NC}" ;;
    esac
}

show_status() {
    echo ""
    echo -e "${BLUE}当前配置状态${NC}"
    local active
    active=$(config_get '.active_profile')

    [[ -z "$active" ]] && { echo -e "  ${YELLOW}暂无活跃配置${NC}"; return; }

    local provider haiku sonnet opus provider_name
    provider=$(config_get ".profiles[\"$active\"].provider")
    haiku=$(config_get ".profiles[\"$active\"].haiku")
    sonnet=$(config_get ".profiles[\"$active\"].sonnet")
    opus=$(config_get ".profiles[\"$active\"].opus")
    provider_name=$(config_get ".providers.$provider.name")

    echo "  活跃配置: $active"
    echo "  服务商:   $provider_name"
    echo ""
    echo "  模型:"
    echo "    haiku:  $haiku"
    echo "    sonnet: $sonnet"
    echo "    opus:   $opus"
}

# Launch
select_and_launch() {
    local profiles
    profiles=($(config_get '.profiles | keys[]'))

    [[ ${#profiles[@]} -eq 0 ]] && { echo -e "${YELLOW}暂无配置，请先运行 'mm setup'${NC}"; return; }

    local active
    active=$(config_get '.active_profile')

    local profile
    if [[ -n "$active" ]] && config_get ".profiles[\"$active\"]" >/dev/null 2>&1 && [[ -n "$(config_get ".profiles[\"$active\"]")" ]]; then
        profile="$active"
    elif [[ ${#profiles[@]} -eq 1 ]]; then
        profile="${profiles[0]}"
    else
        profile=$(fzf_select "选择配置:" "${profiles[@]}")
    fi

    [[ -z "$profile" ]] && { echo -e "${YELLOW}已取消${NC}"; return; }

    launch_profile "$profile" "$@"
}

launch_profile() {
    local profile="$1"; shift 2>/dev/null || true

    local provider haiku sonnet opus base_url api_key provider_name
    provider=$(config_get ".profiles[\"$profile\"].provider")
    haiku=$(config_get ".profiles[\"$profile\"].haiku")
    sonnet=$(config_get ".profiles[\"$profile\"].sonnet")
    opus=$(config_get ".profiles[\"$profile\"].opus")
    base_url=$(config_get ".providers.$provider.base_url")
    provider_name=$(config_get ".providers.$provider.name")

    api_key=$(get_api_key "$provider")
    [[ -z "$api_key" ]] && { echo -e "${RED}错误: $provider_name API Key 未配置${NC}"; echo "运行 ${CYAN}mm setup${NC}"; exit 1; }

    config_set ".active_profile = \"$profile\""

    echo -e "${GREEN}✓ 已切换到: $provider_name${NC}"
    echo ""

    export ANTHROPIC_BASE_URL="$base_url"
    export ANTHROPIC_AUTH_TOKEN="$api_key"
    export ANTHROPIC_DEFAULT_HAIKU_MODEL="$haiku"
    export ANTHROPIC_DEFAULT_SONNET_MODEL="$sonnet"
    export ANTHROPIC_DEFAULT_OPUS_MODEL="$opus"

    local claude_args=()
    [[ $(config_get '.options.skip_permissions') == "true" ]] && claude_args+=("--dangerously-skip-permissions")
    claude_args+=("$@")

    exec claude "${claude_args[@]}"
}

# Main
main() {
    check_jq
    init_config

    local cmd="${1:-}"

    # Handle -p <profile>
    if [[ "$cmd" == "-p" ]]; then
        local profile="${2:-}"
        [[ -z "$profile" ]] && { echo -e "${RED}错误: -p 需要指定 profile 名称${NC}"; exit 1; }
        if [[ -z "$(config_get ".profiles[\"$profile\"]")" ]]; then
            echo -e "${RED}错误: profile '$profile' 不存在${NC}"
            exit 1
        fi
        shift 2
        launch_profile "$profile" "$@"
        return
    fi

    case "$cmd" in
        "")
            if ! has_profiles || ! has_any_api_key; then
                echo -e "${YELLOW}首次使用，请先配置${NC}"
                setup_wizard
                return
            fi
            select_and_launch "$@"
            ;;
        setup) setup_wizard ;;
        update)
            local install_dir="$HOME/.mukits"
            if [[ -d "$install_dir/.git" ]]; then
                echo -e "${BLUE}更新 MUKits...${NC}"
                git -C "$install_dir" pull --ff-only && echo -e "${GREEN}✓ 更新完成${NC}" || echo -e "${RED}更新失败${NC}"
            else
                echo -e "${RED}错误: 安装目录不是 git 仓库，请重新运行安装脚本${NC}"
                exit 1
            fi
            ;;
        help|-h|--help)
            echo "MM - Claude Code 简易启动器"
            echo ""
            echo "用法: mm [命令]"
            echo ""
            echo "命令:"
            echo "  mm              用默认配置启动 Claude Code"
            echo "  mm -p <profile> 指定 profile 启动"
            echo "  mm setup        配置向导"
            echo "  mm update       更新到最新版本"
            echo "  mm help         显示帮助"
            ;;
        *)
            if [[ -n "$(config_get ".profiles[\"$cmd\"]")" ]]; then
                launch_profile "$@"
            else
                echo -e "${RED}错误: 未知命令 '$cmd'${NC}"
                exit 1
            fi
            ;;
    esac
}

main "$@"
