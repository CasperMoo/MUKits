#!/usr/bin/env bash
# mmc - Claude Code provider/profile manager
# Usage: mmc <profile> [-- <claude args>]

set -euo pipefail

# Config paths
MMC_CONFIG_DIR="${MMC_CONFIG_DIR:-$HOME/.mukits}"
MMC_CONFIG_FILE="$MMC_CONFIG_DIR/config.json"

# Default config template
DEFAULT_CONFIG='{
  "providers": {
    "deepseek": {
      "base_url": "https://api.deepseek.com/anthropic",
      "api_key_env": "DEEPSEEK_API_KEY",
      "models": ["deepseek-chat", "deepseek-v3"]
    },
    "glm": {
      "base_url": "https://open.bigmodel.cn/api/paas/v4/",
      "api_key_env": "GLM_API_KEY",
      "models": ["glm-4", "glm-4.5-air", "glm-4.7"]
    },
    "anthropic": {
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY",
      "models": ["claude-sonnet-4-20250514", "claude-opus-4-20250514", "claude-haiku-4-20250514"]
    }
  },
  "profiles": {
    "glm": {
      "provider": "glm",
      "haiku": "glm-4.5-air",
      "sonnet": "glm-4.7",
      "opus": "glm-4.7"
    },
    "ds": {
      "provider": "deepseek",
      "haiku": "deepseek-chat",
      "sonnet": "deepseek-v3",
      "opus": "deepseek-v3"
    },
    "anthropic": {
      "provider": "anthropic",
      "haiku": "claude-haiku-4-20250514",
      "sonnet": "claude-sonnet-4-20250514",
      "opus": "claude-opus-4-20250514"
    }
  }
}'

# Check jq dependency
check_jq() {
    if ! command -v jq &>/dev/null; then
        echo "Error: jq is required but not installed." >&2
        echo "Install with: brew install jq (macOS) or apt install jq (Linux)" >&2
        exit 1
    fi
}

# Initialize config file if not exists
init_config() {
    if [[ ! -f "$MMC_CONFIG_FILE" ]]; then
        mkdir -p "$MMC_CONFIG_DIR"
        echo "$DEFAULT_CONFIG" > "$MMC_CONFIG_FILE"
        echo "Created config: $MMC_CONFIG_FILE"
        echo "Edit with: mmc config"
    fi
}

# Get JSON value from config
# Usage: config_get ".providers.deepseek.base_url"
config_get() {
    jq -r "$1 // empty" "$MMC_CONFIG_FILE"
}

# List all profiles
list_profiles() {
    echo "Available profiles:"
    echo ""
    local profiles
    profiles=$(config_get '.profiles | keys[]')
    for p in $profiles; do
        local provider
        provider=$(config_get ".profiles.$p.provider")
        local haiku sonnet opus
        haiku=$(config_get ".profiles.$p.haiku")
        sonnet=$(config_get ".profiles.$p.sonnet")
        opus=$(config_get ".profiles.$p.opus")
        echo "  $p"
        echo "    provider: $provider"
        echo "    haiku:    $haiku"
        echo "    sonnet:   $sonnet"
        echo "    opus:     $opus"
        echo ""
    done
}

# Show current environment status
show_status() {
    echo "Current Claude Code environment:"
    echo ""
    echo "  ANTHROPIC_BASE_URL:           ${ANTHROPIC_BASE_URL:-<not set>}"
    echo "  ANTHROPIC_DEFAULT_HAIKU_MODEL: ${ANTHROPIC_DEFAULT_HAIKU_MODEL:-<not set>}"
    echo "  ANTHROPIC_DEFAULT_SONNET_MODEL: ${ANTHROPIC_DEFAULT_SONNET_MODEL:-<not set>}"
    echo "  ANTHROPIC_DEFAULT_OPUS_MODEL:  ${ANTHROPIC_DEFAULT_OPUS_MODEL:-<not set>}"
    echo ""
}

# Get API key for provider
# Usage: get_api_key <provider_name>
get_api_key() {
    local provider="$1"
    local env_var
    env_var=$(config_get ".providers.$provider.api_key_env")

    if [[ -z "$env_var" ]]; then
        echo "Error: No api_key_env defined for provider: $provider" >&2
        return 1
    fi

    # Check environment variable
    if [[ -n "${!env_var:-}" ]]; then
        echo "${!env_var}"
        return 0
    fi

    # Prompt user
    echo ""
    echo "API Key not found for: $provider"
    echo "Environment variable: $env_var"
    echo ""
    read -p "Enter API Key: " -r user_key
    [[ -z "$user_key" ]] && return 1

    # Ask to save to shell config
    read -p "Add to ~/.zshrc? [y/N] " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo "export $env_var='$user_key'" >> ~/.zshrc
        echo "Added to ~/.zshrc (restart shell or source to apply)"
    fi

    echo "$user_key"
}

# Validate profile configuration
# Usage: validate_profile <profile_name>
validate_profile() {
    local profile="$1"
    local provider haiku sonnet opus

    provider=$(config_get ".profiles.$profile.provider")
    haiku=$(config_get ".profiles.$profile.haiku")
    sonnet=$(config_get ".profiles.$profile.sonnet")
    opus=$(config_get ".profiles.$profile.opus")

    if [[ -z "$provider" ]]; then
        echo "Error: Profile '$profile' missing 'provider' field" >&2
        return 1
    fi
    if [[ -z "$haiku" ]]; then
        echo "Error: Profile '$profile' missing 'haiku' field" >&2
        return 1
    fi
    if [[ -z "$sonnet" ]]; then
        echo "Error: Profile '$profile' missing 'sonnet' field" >&2
        return 1
    fi
    if [[ -z "$opus" ]]; then
        echo "Error: Profile '$profile' missing 'opus' field" >&2
        return 1
    fi

    # Validate provider exists
    local base_url
    base_url=$(config_get ".providers.$provider.base_url")
    if [[ -z "$base_url" ]]; then
        echo "Error: Provider '$provider' not found in config" >&2
        return 1
    fi
}

# Launch claude with profile
# Usage: launch_profile <profile> [claude args...]
launch_profile() {
    local profile="$1"
    shift

    # Validate profile
    if ! validate_profile "$profile"; then
        exit 1
    fi

    local provider base_url api_key haiku sonnet opus

    provider=$(config_get ".profiles.$profile.provider")
    base_url=$(config_get ".providers.$provider.base_url")
    haiku=$(config_get ".profiles.$profile.haiku")
    sonnet=$(config_get ".profiles.$profile.sonnet")
    opus=$(config_get ".profiles.$profile.opus")

    # Get API key
    api_key=$(get_api_key "$provider")
    if [[ -z "$api_key" ]]; then
        echo "Error: No API key available for provider: $provider" >&2
        exit 1
    fi

    echo "Switching to profile: $profile (provider: $provider)"
    echo ""

    # Export environment variables
    export ANTHROPIC_BASE_URL="$base_url"
    export ANTHROPIC_AUTH_TOKEN="$api_key"
    export ANTHROPIC_DEFAULT_HAIKU_MODEL="$haiku"
    export ANTHROPIC_DEFAULT_SONNET_MODEL="$sonnet"
    export ANTHROPIC_DEFAULT_OPUS_MODEL="$opus"

    # Launch claude
    exec claude "$@"
}

# Interactive profile selection
interactive_select() {
    local profiles
    profiles=($(config_get '.profiles | keys[]'))

    if [[ ${#profiles[@]} -eq 0 ]]; then
        echo "No profiles configured. Run 'mmc config' to add one." >&2
        exit 1
    fi

    if command -v fzf &>/dev/null; then
        printf '%s\n' "${profiles[@]}" | fzf --prompt="Select profile > " --height=40%
    else
        echo "Available profiles:"
        local i=1
        for p in "${profiles[@]}"; do
            local provider
            provider=$(config_get ".profiles.$p.provider")
            echo "  $i) $p ($provider)"
            ((i++))
        done
        echo ""
        read -p "Select [1-${#profiles[@]}]: " selection
        echo "${profiles[$((selection-1))]}"
    fi
}

# Show usage
show_usage() {
    cat << 'USAGE'
Usage: mmc <profile> [-- <claude args>]

Commands:
  <profile>    Launch claude with the specified profile
  ls           List all available profiles
  status       Show current environment variables
  config       Edit configuration file
  help         Show this help

Examples:
  mmc glm                    # Launch with glm profile
  mmc glm -- -y "hello"      # Pass arguments to claude
  mmc ds -- --dangerously-skip-permissions
  mmc ls                     # List profiles
  mmc                        # Interactive selection

Config file: ~/.mukits/config.json
USAGE
}

# Main
main() {
    check_jq
    init_config

    local command="${1:-}"

    case "$command" in
        "")
            # Interactive mode
            local profile
            profile="$(interactive_select)"
            [[ -z "$profile" ]] && exit 1
            launch_profile "$profile"
            ;;

        "help"|"-h"|"--help")
            show_usage
            ;;

        "ls"|"list")
            list_profiles
            ;;

        "status")
            show_status
            ;;

        "config")
            local editor="${EDITOR:-vi}"
            "$editor" "$MMC_CONFIG_FILE"
            ;;

        *)
            # Treat as profile name
            launch_profile "$@"
            ;;
    esac
}

main "$@"
